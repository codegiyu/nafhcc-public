# Required on Vercel for canonical URLs, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics (GA4 measurement ID)
NEXT_PUBLIC_ANALYTICS_ID=

# Optional search engine verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional SEO image overrides (defaults use placeholder URLs in lib/seo/site-images.ts)
NEXT_PUBLIC_SEO_LOGO_URL=
NEXT_PUBLIC_SEO_OG_IMAGE_URL=
NEXT_PUBLIC_SEO_FAVICON_URL=

# Set to true to allow indexing on Vercel preview deployments
SEO_ALLOW_INDEXING=false

# Production gate for /internal/styleguide (?key= or httpOnly cookie)
STYLEGUIDE_SECRET=

# Contact form email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_MAIL_FROM=noreply@nafhcc.com
CONTACT_MAIL_FROM_NAME=NAFHCC Website
CONTACT_MAIL_TO=info@nafhcc.com
